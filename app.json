{
  "expo": {
    "name": "Geska",
    "slug": "geska",
    "version": "0.9.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scarfenn.geska"
    },
    "android": {
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.scarfenn.geska"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F7FA",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101C24",
            "image": "./assets/adaptive-icon.png"
          }
        }
      ],
      "expo-system-ui",
      "./plugins/withAndroidAppTheme"
    ],
    "extra": {
      "eas": {
        "projectId": "ce9d4753-7e07-4082-81de-c85d2b226923"
      }
    }
  }
}
